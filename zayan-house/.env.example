# ---------- Zayan House environment variables ----------
# Copy this file to ".env" and fill in your OWN new values.
# NEVER commit the real .env file or share it with anyone.

# PostgreSQL connection string (your new database)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zayan_house"

# Long random secret used to sign login sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# Public URL of the website (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp number with country code, digits only (example: 8801XXXXXXXXX).
# This is only the STARTING value; you can change it later in Admin > Settings.
WHATSAPP_NUMBER="8801XXXXXXXXX"

# Set to "true" only if your database provider requires SSL (Neon, Supabase, etc.)
DATABASE_SSL="false"
